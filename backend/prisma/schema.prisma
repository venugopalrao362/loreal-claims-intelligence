generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Claim {
  id          String       @id @default(uuid())
  title       String
  description String
  assessments Assessment[]
}

model Assessment {
  id              String   @id @default(uuid())
  claimId         String
  claim           Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  evidenceText    String
  isJustified     Boolean
  confidenceScore Float
  reasoning       String
  createdAt       DateTime @default(now())
}